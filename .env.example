# Jedyne wymagane ustawienie: adres bazy PostgreSQL.
# Na Heroku ustawia go dodatek Heroku Postgres (DATABASE_URL) – nic nie wpisujesz ręcznie.
# Konta szafarzy zakłada się w aplikacji (strona /konta), klucz sesji generuje się sam w bazie.
DATABASE_URL=
# Opcjonalnie:
# REVEAL_CODE=1234     # kod do odkrywania nazwisk chorych na ekranie
# SESSION_DAYS=14      # ile dni trwa zalogowanie
# Test lokalny bez bazy: DATABASE_URL=memory
