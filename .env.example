# Skopiuj do .env tylko na własnym komputerze. Na Heroku ustaw te same wartości przez: heroku config:set ...
NODE_ENV=production
# Losowy, długi ciąg (min. 32 znaki), np.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Konta szafarzy – wynik: npm run users -- users.local.json
USERS=
# Kod do odkrywania nazwisk chorych na ekranie
REVEAL_CODE=1234
# Ile dni trwa zalogowanie
SESSION_DAYS=14
# Adres bazy PostgreSQL. Na Heroku ustawia go dodatek Heroku Postgres (nie wpisuj ręcznie).
# Lokalnie np.: DATABASE_URL=postgres://user:haslo@localhost:5432/szafarz  oraz  DATABASE_SSL=false
DATABASE_URL=
# SEED_DEMO=1   # tylko do testów: 10 przykładowych (fikcyjnych) chorych
